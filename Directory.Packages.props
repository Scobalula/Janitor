<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Override with -p:RedFoxPackageVersion=<version> when using a local RedFox package feed. -->
    <RedFoxPackageVersion Condition="'$(RedFoxPackageVersion)' == ''">2026.10.2-local.g8284919.t20261002214230</RedFoxPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="RedFox.Compression.LZ4" Version="$(RedFoxPackageVersion)" />
    <PackageVersion Include="RedFox.GameExtraction" Version="$(RedFoxPackageVersion)" />
    <PackageVersion Include="RedFox.GameExtraction.CommandLine" Version="$(RedFoxPackageVersion)" />
    <PackageVersion Include="RedFox.GameExtraction.Hashing" Version="$(RedFoxPackageVersion)" />
    <PackageVersion Include="RedFox.GameExtraction.UI" Version="$(RedFoxPackageVersion)" />
    <PackageVersion Include="RedFox.Graphics3D" Version="$(RedFoxPackageVersion)" />
    <PackageVersion Include="RedFox.Graphics3D.Formats" Version="$(RedFoxPackageVersion)" />
    <PackageVersion Include="RedFox.Imaging" Version="$(RedFoxPackageVersion)" />
    <PackageVersion Include="RedFox.Imaging.Formats" Version="$(RedFoxPackageVersion)" />
    <PackageVersion Include="RedFox.Imaging.Vulkan" Version="$(RedFoxPackageVersion)" />
    <PackageVersion Include="RedFox.IO" Version="$(RedFoxPackageVersion)" />
    <PackageVersion Include="RedFox.Patterns" Version="$(RedFoxPackageVersion)" />
  </ItemGroup>
</Project>