<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Wwise\packed_codebooks.bin" LogicalName="Janitor.Wwise.packed_codebooks.bin" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Native\vorbis.dll" Link="Native\vorbis.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RedFox.Audio" />
    <PackageReference Include="RedFox.Audio.Opus" />
    <PackageReference Include="RedFox.Compression.LZ4" />
    <PackageReference Include="RedFox.GameExtraction" />
    <PackageReference Include="RedFox.GameExtraction.Hashing" />
    <PackageReference Include="RedFox.Graphics3D" />
    <PackageReference Include="RedFox.Graphics3D.Formats" />
    <PackageReference Include="RedFox.Imaging" />
    <PackageReference Include="RedFox.Imaging.Formats" />
    <PackageReference Include="RedFox.Imaging.Vulkan" />
    <PackageReference Include="RedFox.IO" />
    <PackageReference Include="RedFox.Patterns" />
  </ItemGroup>

</Project>
